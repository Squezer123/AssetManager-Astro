---
import Layout from "../layouts/Layout.astro";

const stats = [
  { value: "420+", label: "pozycji w magazynie" },
  { value: "24 h", label: "wsparcia technicznego" },
  { value: "4,9/5", label: "oceny klientów" },
];

const navLinks = [
  { label: "Katalog", href: "/katalog" },
  { label: "Blog", href: "/blog" },
  { label: "O nas", href: "/o-nas" },
  { label: "Kontakt", href: "/kontakt" },
];
---

<Layout>
  <header
    class="sticky top-0 z-50 border-b border-border/80 bg-bg/90 backdrop-blur"
  >
    <div
      class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-4 lg:px-10"
    >
      <a href="/" class="flex items-center gap-2.5">
        <span
          class="flex h-9 w-9 items-center justify-center rounded-full bg-accent/15 text-accent"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a10 10 0 0 1 6.5 17.5"></path>
            <path d="m9 15 3-3 3 3"></path>
          </svg>
        </span>
        <span class="text-lg font-semibold tracking-tight">RentGear</span>
      </a>

      <nav class="hidden items-center gap-8 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-5">
        <button
          type="button"
          aria-label="Koszyk"
          class="text-muted transition-colors hover:text-white"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path
              d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
            ></path>
          </svg>
        </button>
        <a
          href="/logowanie"
          class="hidden text-sm text-muted transition-colors hover:text-white sm:block"
        >
          Zaloguj
        </a>
        <a
          href="/rejestracja"
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition-colors hover:bg-accent-hover"
        >
          Załóż konto
        </a>
      </div>
    </div>
  </header>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/hero-bg.jpg"
        alt=""
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-bg via-bg/85 to-bg/40"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-bg/40">
      </div>
    </div>

    <div class="relative mx-auto max-w-[1440px] px-6 py-24 lg:px-10 lg:py-32">
      <div class="max-w-2xl">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/40 px-4 py-1.5 text-sm font-medium text-accent"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path>
          </svg>
          Odbiór tego samego dnia w Warszawie
        </div>

        <h1
          class="text-5xl font-bold leading-[1.1] tracking-tight text-white sm:text-6xl lg:text-[64px]"
        >
          Profesjonalny sprzęt na plan, <span class="text-accent"
            >gotowy w 2 minuty</span
          >
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Aparaty, drony, oświetlenie i dźwięk dla produkcji filmowych,
          agencji i twórców. Przejrzysta cena za dobę, realny stan magazynu,
          sprzęt serwisowany przed każdym wynajmem.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="/katalog"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-bg transition-colors hover:bg-accent-hover"
          >
            Wypożycz sprzęt teraz
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="/blog"
            class="inline-flex items-center rounded-full border border-border px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-muted"
          >
            Czytaj poradniki
          </a>
        </div>

        <dl class="mt-16 flex flex-wrap gap-x-12 gap-y-6">
          {
            stats.map((stat) => (
              <div>
                <dt class="text-3xl font-bold text-accent">{stat.value}</dt>
                <dd class="mt-1 text-sm text-muted">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Layout>